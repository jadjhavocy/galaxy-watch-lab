<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="GWL Music Companion" android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false">
        <activity android:name="dev.galaxywatchlab.mobile.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Android binds this after an explicit user grant. It never reads notification content. -->
        <service android:name="dev.galaxywatchlab.mobile.MediaAccessListener"
            android:label="GWL — доступ только к медиасеансам"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <!-- Play Services only; user must separately arm two-minute remote window. -->
        <service android:name="dev.galaxywatchlab.mobile.WatchMessageListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:path="/gwl/v1/media" />
            </intent-filter>
        </service>
    </application>
</manifest>
